+// ============================ FSR-Mamba capture ============================
+
+#if defined(FFX_API_DX12)
+namespace
+{
+    // Describe a DXGI format for the PyTorch loader as (channels, numpy dtype).
+    // Keyed on DXGI_FORMAT rather than Cauldron's ResourceFormat because the
+    // depth target's format is not in Cauldron's GetResourceFormatStride table
+    // (that omission is what aborted the first capture). GetCopyableFootprints
+    // supplies the actual byte layout, so this only needs to name the dtype.
+    void DescribeDxgiFormat(DXGI_FORMAT fmt, int& channels, std::string& dtype)
+    {
+        switch (fmt)
+        {
+        case DXGI_FORMAT_R8_UNORM:            channels = 1; dtype = "uint8";   break;
+        case DXGI_FORMAT_R8G8_UNORM:          channels = 2; dtype = "uint8";   break;
+        case DXGI_FORMAT_R8G8B8A8_UNORM:
+        case DXGI_FORMAT_R8G8B8A8_UNORM_SRGB:
+        case DXGI_FORMAT_B8G8R8A8_UNORM:      channels = 4; dtype = "uint8";   break;
+        case DXGI_FORMAT_R16_FLOAT:           channels = 1; dtype = "float16"; break;
+        case DXGI_FORMAT_R16G16_FLOAT:        channels = 2; dtype = "float16"; break;
+        case DXGI_FORMAT_R16G16B16A16_FLOAT:  channels = 4; dtype = "float16"; break;
+        case DXGI_FORMAT_R16G16B16A16_UNORM:  channels = 4; dtype = "uint16";  break;
+        case DXGI_FORMAT_R16_UNORM:           channels = 1; dtype = "uint16";  break;
+        case DXGI_FORMAT_R32_TYPELESS:
+        case DXGI_FORMAT_D32_FLOAT:
+        case DXGI_FORMAT_R32_FLOAT:           channels = 1; dtype = "float32"; break;
+        case DXGI_FORMAT_R32G32_FLOAT:        channels = 2; dtype = "float32"; break;
+        case DXGI_FORMAT_R32G32B32A32_FLOAT:  channels = 4; dtype = "float32"; break;
+        case DXGI_FORMAT_R11G11B10_FLOAT:     channels = 3; dtype = "rg11b10"; break; // packed 32-bit
+        case DXGI_FORMAT_R10G10B10A2_UNORM:   channels = 4; dtype = "rgb10a2"; break; // packed 32-bit
+        default:                              channels = 0; dtype = "raw";     break;
+        }
+    }
+}
+#endif
